{
  "name": "@ezkart/cloudflare-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wrangler deploy --dry-run --config wrangler.example.jsonc --env production",
    "check:beta": "wrangler deploy --dry-run --config wrangler.example.jsonc --env beta",
    "dev": "wrangler dev --env test",
    "deploy:test": "wrangler deploy --env test",
    "deploy:beta": "wrangler deploy --env beta",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:test": "wrangler d1 migrations apply DB --env test --remote",
    "db:migrate:beta": "wrangler d1 migrations apply DB --env beta --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.121.0"
  },
  "dependencies": {
    "entities": "^8.1.0"
  }
}
