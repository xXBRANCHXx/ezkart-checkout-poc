{
  // Copy this file to wrangler.jsonc, replace every PASTE_ value, and keep
  // wrangler.jsonc as the source of truth for Cloudflare bindings.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ezkart-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "env": {
    "test": {
      "name": "ezkart-api-test",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": ["17 * * * *", "* * * * *", "*/2 * * * *", "0-59/3,1-59/3 * * * *"] },
      "vars": {
        "APP_ENVIRONMENT": "test",
        "COMMERCE_NOTIFICATIONS": "enabled",
        "ALLOWED_ORIGINS": "https://test.ezkart.id,http://127.0.0.1:4173",
        "SUPABASE_URL": "https://rwxxjqvoidpkuqftgkjd.supabase.co"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ezkart_test_database",
          "database_id": "PASTE_TEST_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PUBLIC_ASSETS", "bucket_name": "ezkart-test-public" },
        { "binding": "PRIVATE_ASSETS", "bucket_name": "ezkart-test-private" }
      ]
    },
    "beta": {
      "name": "ezkart-api-beta",
      "workers_dev": true,
      "preview_urls": false,
      // Connect only after isolated data preparation and provider acceptance.
      "triggers": { "crons": [] },
      "vars": {
        "APP_ENVIRONMENT": "beta",
        "COMMERCE_STORAGE": "legacy",
        "COMMERCE_CHECKOUT": "held",
        // Before routing acceptance, configure COMMERCE_PLATFORM_WALLET_SELLER
        // only to a dedicated Ezkart fee store with a confirmed Sub-Account.
        // See docs/doku-payment-routing.md. No default destination is safe.
        "ALLOWED_ORIGINS": "https://test.ezkart.id",
        "SUPABASE_URL": "https://rwxxjqvoidpkuqftgkjd.supabase.co"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ezkart_beta_database",
          "database_id": "PASTE_BETA_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PUBLIC_ASSETS", "bucket_name": "ezkart-beta-public" },
        { "binding": "PRIVATE_ASSETS", "bucket_name": "ezkart-beta-private" }
      ]
    },
    "production": {
      "name": "ezkart-api-production",
      "routes": [
        { "pattern": "api.ezkart.id", "custom_domain": true }
      ],
      "vars": {
        "APP_ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://ezkart.id",
        "SUPABASE_URL": "https://rwxxjqvoidpkuqftgkjd.supabase.co"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ezkart_main_user_database",
          "database_id": "f8cf09d0-9ca0-4e43-8ae6-98bd6e95eb46",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PUBLIC_ASSETS", "bucket_name": "ezkart-production-public" },
        { "binding": "PRIVATE_ASSETS", "bucket_name": "ezkart-production-private" }
      ]
    }
  }
}
