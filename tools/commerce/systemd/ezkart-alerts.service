[Unit]
Description=Bounded Ezkart operations alert delivery
# Report collectors and recipient adapter must be installed separately.

[Service]
Type=oneshot
WorkingDirectory=%h/ezkart-operations
EnvironmentFile=%h/.config/ezkart-alerts/credentials.env
ExecStart=/usr/bin/python3 -B %h/ezkart-operations/tools/commerce/operations-alert-runner.py run --config=%h/.config/ezkart-alerts/runner.json
# Exit 2 means delivery or configuration still needs attention, not a process crash.
SuccessExitStatus=2
TimeoutStartSec=6min
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

