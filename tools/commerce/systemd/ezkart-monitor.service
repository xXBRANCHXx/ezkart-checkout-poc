[Unit]
Description=Collect bounded Ezkart commerce and backup reports

[Service]
Type=oneshot
WorkingDirectory=%h/ezkart-operations
EnvironmentFile=%h/.config/ezkart-monitor/credentials.env
ExecStart=/usr/bin/python3 -B %h/ezkart-operations/tools/commerce/operations-monitor.py collect --config=%h/.config/ezkart-monitor/monitor.json
SuccessExitStatus=2
TimeoutStartSec=5min
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
